{
    "name": "com.miragenet.mirage",
    "displayName": "Mirage",
    "version": "159.1.1",
    "unity": "2021.3",
    "description": "Mirage is a high level Networking API for Unity, supporting different low level Transports.",
    "author": "Mirage",
    "repository": {
        "type": "git",
        "url": "https://github.com/MirageNet/Mirage.git"
    },
    "dependencies": {
        "com.unity.nuget.mono-cecil": "1.10.1",
        "com.cysharp.unitask": "2.3.3"
    },
    "samples": [
        {
            "displayName": "AdditiveScenes",
            "description": "Adding and removing scenes in multiplayer games",
            "path": "Samples~/AdditiveScenes"
        },
        {
            "displayName": "Basic",
            "description": "Demonstrate simple setup and synchronizing data",
            "path": "Samples~/Basic"
        },
        {
            "displayName": "ChangeScene",
            "description": "Demo for normal or additive scene switching",
            "path": "Samples~/ChangeScene"
        },
        {
            "displayName": "InterestManagement",
            "description": "Demo for interest management",
            "path": "Samples~/InterestManagement"
        },
        {
            "displayName": "Chat",
            "description": "Simple chat and custom UI demo",
            "path": "Samples~/Chat"
        },
        {
            "displayName": "Pong",
            "description": "Classic multiplayer game",
            "path": "Samples~/Pong"
        },
        {
            "displayName": "Tanks",
            "description": "Shoot each other with tanks",
            "path": "Samples~/Tanks"
        },
        {
            "displayName": "MatchScenes",
            "description": "Multiple matches on the same server by creating new scenes for each pair of players",
            "path": "Samples~/MatchScenes"
        },
        {
            "displayName": "LegacyNetworkAnimator",
            "description": "Old NetworkAnimator component, kept for projects that still depend on it",
            "path": "Samples~/LegacyNetworkAnimator"
        },
        {
            "displayName": "LegacySceneLoading",
            "description": "Old NetworkSceneManager and CharacterSpawner, replaced by NetworkSceneLoader",
            "path": "Samples~/LegacySceneLoading"
        },
        {
            "displayName": "MultipleAdditiveScenes",
            "description": "Multiple game instances on one server, each in its own additive physics scene",
            "path": "Samples~/MultipleAdditiveScenes"
        },
        {
            "displayName": "Notify",
            "description": "Using Notify to send changes over unreliable and know when they are delivered or lost",
            "path": "Samples~/Notify"
        },
        {
            "displayName": "RigidbodyPhysics",
            "description": "Syncing server-side rigidbody physics to clients",
            "path": "Samples~/RigidbodyPhysics"
        },
        {
            "displayName": "SendPrefab",
            "description": "Letting clients ask the server to spawn one of an allowed list of prefabs",
            "path": "Samples~/SendPrefab"
        },
        {
            "displayName": "SpawnCustomPlayer",
            "description": "Full scripts for the Custom Character Spawning guide",
            "path": "Samples~/SpawnCustomPlayer"
        },
        {
            "displayName": "SwitchTransport",
            "description": "NetworkManager that can switch socket/transport at runtime",
            "path": "Samples~/SwitchTransport"
        }
    ]
}
